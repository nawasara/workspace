{
    "name": "nawasara/workspace",
    "description": "Kisara Workspace control plane for the Nawasara superapp framework: pilot access, account provisioning, OPD team folders, quotas and templates on top of Nextcloud + OnlyOffice.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "nextcloud",
        "onlyoffice",
        "workspace",
        "kisara"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/workspace/issues",
        "source": "https://github.com/nawasara/workspace"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\Workspace\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-activitylog": "^4.0",
        "livewire/livewire": "^3.0",
        "nawasara/ui": "*",
        "nawasara/vault": "*",
        "nawasara/auth-primitives": "*",
        "nawasara/keycloak": "*",
        "nawasara/registry": "*"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Workspace\\WorkspaceServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
